---
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";

const { title, description, currentPath } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101310" />
    <title>{title} — Infra Intelligence</title>
  </head>
  <body>
    <!--
      THESIS: Infrastructure research is a connected system, not a stack of company cards.
      OWN-WORLD: Graphite work surfaces, ruled signal lines, restrained chartreuse, and precise tabular labels.
      STORY: Move from sector signals to companies, physical dependencies, and an informed next read.
      FIRST VIEWPORT: Persistent left rail; broad dashboard title and date at top; one signal field beside a compact sector ledger.
      FORM: Brief-directed research terminal; dense operator workspace, not a promotional hero. Seed: not used because the brief specifies the terminal form.
    -->
    <div class="app-shell">
      <Sidebar currentPath={currentPath} />
      <div class="main-column">
        <header class="topbar">
          <div class="breadcrumb"><span>INTELLIGENCE</span><span class="crumb-slash">/</span>{title.toUpperCase()}</div>
          <div class="topbar-right">
            <span class="session-state"><i></i> LOCAL SAMPLE</span>
            <span class="topbar-divider"></span>
            <span class="topbar-date">RESEARCH TERMINAL <b>v0.1</b></span>
          </div>
        </header>
        <main id="main-content">
          <slot />
        </main>
        <footer class="site-footer">
          <span>INFRA INTELLIGENCE <b>·</b> RESEARCH CONCEPT</span>
          <span>ALL FIGURES AND ENTITIES ARE ILLUSTRATIVE SAMPLE DATA</span>
        </footer>
      </div>
    </div>
  </body>
</html>
