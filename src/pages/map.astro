---
import SiteLayout from "../layouts/SiteLayout.astro";
import { mapNodes } from "../data/sample";

const links = [
  ["ca", "nw"], ["nw", "mw"], ["mw", "ne"], ["ca", "sw"],
  ["sw", "tx"], ["tx", "se"], ["se", "ne"], ["mw", "tx"],
  ["nw", "sw"], ["mw", "se"],
] as const;
const pointById = new Map(mapNodes.map((node) => [node.id, node]));
---

<SiteLayout
  title="Infrastructure map"
  currentPath="/map/"
  description="An illustrative schematic of fictional infrastructure dependencies."
>
  <div class="page-content">
    <section class="page-heading map-heading">
      <div>
        <p class="eyebrow"><span class="eyebrow-rule"></span> SYSTEMS VIEW / ILLUSTRATIVE</p>
        <h1>Trace the <em>dependencies.</em></h1>
        <p class="heading-copy">A schematic view of how compute, networks, and power connect across a fictional infrastructure landscape.</p>
      </div>
      <div class="heading-aside">
        <div class="asof-label">NETWORK LAYER</div>
        <div class="asof-date">07 <span>DEMO NODES</span></div>
        <div class="asof-note"><span class="sample-dot"></span> NOT GEOGRAPHIC OR LIVE</div>
      </div>
    </section>

    <section class="map-workspace">
      <div class="map-main">
        <div class="map-toolbar">
          <div><span class="map-legend-dot"></span> SAMPLE NETWORK TOPOLOGY <span class="map-separator">/</span> ABSTRACT REGIONS</div>
          <span class="map-coordinates">SCHEMATIC · NOT TO SCALE</span>
        </div>
        <div class="network-map">
          <div class="map-grid" aria-hidden="true"></div>
          <svg viewBox="0 0 660 350" role="img" aria-labelledby="map-title map-desc" class="network-svg">
            <title id="map-title">Fictional infrastructure network schematic</title>
            <desc id="map-desc">Seven sample nodes and illustrative links representing dependencies among compute, energy, and network systems. This is not a map of actual facilities.</desc>
            {links.map(([from, to]) => {
              const a = pointById.get(from);
              const b = pointById.get(to);
              if (!a || !b) return null;
              return <line class="network-link" x1={a.x} y1={a.y} x2={b.x} y2={b.y} />;
            })}
            <path d="M 60 280 C 130 270 144 301 226 281 S 338 298 414 279 S 537 301 623 267" fill="none" stroke="#2d3630" stroke-dasharray="2 8" />
            {mapNodes.map((node) => (
              <g class="map-node" data-kind={node.kind} tabindex="0" role="button" aria-label={`${node.label}, ${node.kind}, ${node.load}`} transform={`translate(${node.x} ${node.y})`}>
                <circle class="node-orbit" r="17" />
                <circle class="node-core" r="4.5" />
                <text class="node-label" x="13" y="-10">{node.label.toUpperCase()}</text>
                <text class="node-kind" x="13" y="4">{node.kind.toUpperCase()}</text>
              </g>
            ))}
            <text x="24" y="326" class="map-foot-text">SAMPLE NETWORK / FICTIONAL NODES &amp; LINKS</text>
            <text x="630" y="326" text-anchor="end" class="map-foot-text">NO LIVE FACILITY DATA</text>
          </svg>
          <div class="map-tooltip" id="map-tooltip" aria-live="polite">Select a node to inspect sample context.</div>
        </div>
        <div class="map-footer">
          <span>CONNECTIONS REPRESENT HYPOTHETICAL DEPENDENCIES ONLY</span>
          <span>DATASET: INTERFACE SAMPLE / v0.1</span>
        </div>
      </div>
      <aside class="map-rail">
        <div class="rail-heading"><span class="eyebrow"><span class="eyebrow-rule"></span> LAYERS</span><span class="layer-count">03</span></div>
        <button class="layer-toggle is-on" data-layer="Compute" aria-pressed="true"><span class="layer-symbol compute-symbol"></span><span>Compute</span><span class="toggle-track"><i></i></span></button>
        <button class="layer-toggle is-on" data-layer="Network" aria-pressed="true"><span class="layer-symbol network-symbol"></span><span>Network</span><span class="toggle-track"><i></i></span></button>
        <button class="layer-toggle is-on" data-layer="Energy" aria-pressed="true"><span class="layer-symbol energy-symbol"></span><span>Energy</span><span class="toggle-track"><i></i></span></button>
        <div class="rail-divider"></div>
        <div class="selected-node">
          <p class="eyebrow"><span class="eyebrow-rule"></span> SAMPLE CONTEXT</p>
          <h2 id="node-title">System view</h2>
          <p id="node-description">Choose a node in the schematic to see its fictional role. Connections are illustrative, not facility or infrastructure reporting.</p>
          <span class="node-status"><i></i> DEMO ONLY</span>
        </div>
        <div class="map-disclaimer"><span>!</span><p>This is an abstract diagram. It does not show real assets, geospatial locations, grid loads, or live infrastructure conditions.</p></div>
      </aside>
    </section>
  </div>
  <script>
    const descriptions: Record<string, string> = {
      Northwest: "Sample compute node. Fictional role used to demonstrate how demand might connect to a regional network.",
      Southwest: "Sample energy node. Fictional role used to illustrate a possible power dependency.",
      Midwest: "Sample network node. Fictional role used to connect regional systems in the schematic.",
      Texas: "Sample energy node. Fictional role used to represent a hypothetical grid interface.",
      Southeast: "Sample compute node. Fictional role used to represent a hypothetical capacity cluster.",
      Northeast: "Sample network node. Fictional role used to illustrate a hypothetical interconnect.",
      Pacific: "Sample compute node. Fictional role used to demonstrate a demand endpoint.",
    };
    const title = document.querySelector<HTMLElement>("#node-title");
    const description = document.querySelector<HTMLElement>("#node-description");
    const tooltip = document.querySelector<HTMLElement>("#map-tooltip");

    document.querySelectorAll<SVGGElement>(".map-node").forEach((node) => {
      const selectNode = () => {
        const label = node.querySelector("text")?.textContent ?? "Sample node";
        const formatted = label.toLowerCase().replace(/\b\w/g, (letter) => letter.toUpperCase());
        if (title) title.textContent = formatted;
        if (description) description.textContent = descriptions[formatted] ?? "Fictional sample node.";
        if (tooltip) tooltip.textContent = `${formatted} · ${node.dataset.kind} · illustrative sample`;
        document.querySelectorAll(".map-node.is-selected").forEach((active) => active.classList.remove("is-selected"));
        node.classList.add("is-selected");
      };
      node.addEventListener("click", selectNode);
      node.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          selectNode();
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>(".layer-toggle").forEach((button) => {
      button.addEventListener("click", () => {
        const enabled = button.getAttribute("aria-pressed") !== "true";
        button.setAttribute("aria-pressed", String(enabled));
        button.classList.toggle("is-on", enabled);
        document.querySelectorAll<SVGGElement>(`.map-node[data-kind="${button.dataset.layer}"]`)
          .forEach((node) => node.classList.toggle("is-muted", !enabled));
      });
    });
  </script>
</SiteLayout>
